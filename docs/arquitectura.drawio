id="res" value="📋 Resumen" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#2e8b57;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="530" width="155" height="62" as="geometry"/></mxCell><mxCell id="pg" value="🗄 Postgres + pgvector" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#e8f1fb;strokeColor=#2f6fb5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="265" width="170" height="130" as="geometry"/></mxCell><mxCell id="api" value="🔌 API consulta (gbd_lector)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fff7d6;strokeColor=#c99a00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="600" width="155" height="62" as="geometry"/></mxCell><mxCell id="analista" value="🧑‍💼 Analista de Garantías" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeee9;strokeColor=#c0504d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="150" height="62" as="geometry"/></mxCell><mxCell id="agencias" value="🏦 Agencias" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeee9;strokeColor=#c0504d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="150" height="62" as="geometry"/></mxCell><mxCell id="wf" value="🔀 Workflow: clasificar → extraer" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeaea;strokeColor=#e5675a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="240" height="62" as="geometry"/></mxCell><mxCell id="modelos" value="🧠 gpt-5-mini (visión) · embeddings" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=11;fillColor=#fdeaea;strokeColor=#e5675a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="240" height="62" 