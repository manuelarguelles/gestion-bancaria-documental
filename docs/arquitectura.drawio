alue="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="exc" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="analiza con políticas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="exc" target="ana_ag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="exc" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="cola HITL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="exc" target="analista"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="estado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="agencias" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="solo lectura" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=0;" edge="1" parent="1" source="ci" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ghcr" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#4a5560;strokeWidth=2;fontSize=10;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="deploy" target="z_fdy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="1" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="28" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="c20" value="2" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="100" width="26" height="26" as="geometry"/></mxCell><mxCell id="c21" value="3" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="778" y="178" width="26" height="26" as="geometry"/></mxCell><mxCell id="c22" value="4" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="263" width="26" height="26" as="geometry"/></mxCell><mxCell id="c23" value="5" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="348" width="26" height="26" as="geometry"/></mxCell><mxCell id="c24" value="6" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="433" width="26" height="26" as="geometry"/></mxCell><mxCell id="c25" value="7" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="778" y="433" width="26" height="26" as="geometry"/></mxCell><mxCell id="c26" value="8" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="28" y="433" width="26" height="26" as="geometry"/></mxCell><mxCell id="c27" value="9" style="ellipse;html=1;fillColor=#0b5cad;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="588" width="26" height="26" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Qué ocurre en cada paso&lt;/b&gt;&lt;br&gt;1  Llega la bandeja: PDFs de cartas fianza y el Excel del Registro de Tesorería.&lt;br&gt;2  Ingestar carga el Excel a Postgres y lee cada PDF por capas: texto nativo por bloques (PyMuPDF), OCR si es escaneo o trae sellos, y visión del modelo si la resolución es baja.&lt;br&gt;3  Cognitivo invoca el workflow de Foundry (clasificar → extraer) y comprueba que número, monto y fecha aparezcan en el texto; si no, relee con visión o pasa a revisión humana.&lt;br&gt;4  Cargar guarda documentos y cartas en Postgres.&lt;br&gt;5  Conciliar aplica reglas puras contra Tesorería: monto, moneda, vencimiento, duplicados, vencidas y por vencer.&lt;br&gt;6  Cada excepción recupera sus políticas internas con búsqueda vectorial en pgvector.&lt;br&gt;7  El agente analista explica la excepción y propone la acción citando solo las políticas recuperadas.&lt;br&gt;8  El analista decide (aprobar, rechazar o escalar): el agente propone, nunca resuelve solo.&lt;br&gt;9  Las agencias consultan estado y vigencia por una API de solo lectura, sin ver el texto de los documentos.&lt;br&gt;Trazas de cada corrida: Foundry &amp;gt; Seguimientos. CI: ruff, tests, imagen a GHCR. El deploy de agentes es manual, con OIDC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1180" height="220" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Naranja: entrada · Verde: servicio · Amarillo: guardrail · Azul: datos · Rosa: persona · Rojo: externo · Gris discontinuo: pendiente. Línea discontinua: relación secundaria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=11;fillColor=#ffffff;strokeColor=#c3cad3;spacing=8;" vertex="1" parent="1"><mxGeometry x="1215" y="830" width="310" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>