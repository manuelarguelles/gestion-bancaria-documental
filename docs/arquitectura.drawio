<mxfile host="app.diagrams.net"><diagram name="Gestión Bancaria Documental — Arquitectura de componentes" id="arq"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Gestión Bancaria Documental — Arquitectura de componentes" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Segoe UI;align=left;fontColor=#1b2733;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="z_ent" value="Entradas y personas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=none;strokeColor=#c0504d;fontColor=#c0504d;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="190" height="590" as="geometry"/></mxCell><mxCell id="z_doc" value="Contenedor Docker · workflow local (Agent Framework) + Tesseract + data plane" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#f8fcfa;strokeColor=#2e8b57;fontColor=#2e8b57;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="500" height="590" as="geometry"/></mxCell><mxCell id="z_fdy" value="Microsoft Foundry · proyecto (Entra ID, sin API keys)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=none;strokeColor=#e5675a;fontColor=#e5675a;dashed=1;dashPattern=6 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="300" height="590" as="geometry"/></mxCell><mxCell id="z_ci" value="GitHub · CI/CD (Actions, OIDC, sin secretos en el repo)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=1