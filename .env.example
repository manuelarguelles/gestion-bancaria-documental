# Copia a .env (ignorado por git) y completa. NUNCA subas .env.
# --- Postgres local (docker compose) ---
POSTGRES_USER=gbd
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=gbd
POSTGRES_PORT=55440
# --- Microsoft Foundry (la autenticación es por Entra ID, sin API keys) ---
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
# Fecha de corte de la conciliación (por defecto: hoy)
GBD_FECHA_CORTE=
